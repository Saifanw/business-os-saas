rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "saif.anwar1618@gmail.com"
      );
    }
    function userBusinessId() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId
        : null;
    }
    // Invitation document id is the lower-cased email (see team-settings.html invite()).
    function inviteExists(businessId) {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/businesses/$(businessId)/teamInvites/$(request.auth.token.email.lower()));
    }
    function invite(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/teamInvites/$(request.auth.token.email.lower())).data;
    }
    // Team member access requires ALL of: users/{uid} linked to this business (doc id = auth uid),
    // the linked profile email equals the signed-in token email, and an ACTIVE invitation for that email.
    // Disabling or deleting the invitation therefore revokes Firestore access immediately.
    function isActiveTeamMember(businessId) {
      return signedIn()
        && userBusinessId() == businessId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.auth.token.email
        && inviteExists(businessId)
        && invite(businessId).status == 'active';
    }
    function isOwnerOfBusiness(businessId) {
      return signedIn() && (
        request.auth.uid == businessId ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid
        ) ||
        (
          userBusinessId() == businessId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        )
      );
    }
    function ownsBusiness(businessId) {
      return isOwnerOfBusiness(businessId) || isActiveTeamMember(businessId);
    }
    function isBusinessManager(businessId) {
      return isOwnerOfBusiness(businessId) || (isActiveTeamMember(businessId) && invite(businessId).role == 'admin');
    }
    function canClaimBusiness(businessId) {
      return signedIn()
        && resource.data.ownerUid == ''
        && resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','status','onboardingStatus','updatedAt']);
    }
    function canCreateLegacyUser(uid) {
      return signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.businessId == uid;
    }
    function canUpdateUserProfile(uid) {
      return signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','updatedAt','businessName','templateId']);
    }
    function canLinkClaimedUser(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.businessId != null
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerUid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','email','displayName','businessId','businessName','role','templateId','createdAt','updatedAt']);
    }
    function canJoinInvitedUser(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.businessId != null
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/teamInvites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/teamInvites/$(request.auth.token.email.lower())).data.status == 'active'
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)/teamInvites/$(request.auth.token.email.lower())).data.role == request.resource.data.role;
    }

    function canJoinByToken(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'sales'
        && request.resource.data.joinToken is string
        && exists(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken))
        && get(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken)).data.status == 'active'
        && get(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken)).data.role == 'sales'
        && get(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken)).data.businessId == request.resource.data.businessId
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));
    }

    match /teamJoinLinks/{token} {
      allow read: if signedIn() && (resource.data.status == 'active' || isOwnerOfBusiness(resource.data.businessId) || isBusinessManager(resource.data.businessId));
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['businessId','role','status','createdBy','createdAt','updatedAt'])
        && request.resource.data.role == 'sales' && request.resource.data.status == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId))
        && (isOwnerOfBusiness(request.resource.data.businessId) || isBusinessManager(request.resource.data.businessId));
      allow update: if signedIn() && (isOwnerOfBusiness(resource.data.businessId) || isBusinessManager(resource.data.businessId))
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if signedIn() && (isOwnerOfBusiness(resource.data.businessId) || isBusinessManager(resource.data.businessId));
    }

    // Collection-group query on teamInvites (invite lookup at first sign-in). A person can only
    // list invitations addressed to their own signed-in email; write access stays manager-only below.
    match /{path=**}/teamInvites/{inviteId} {
      allow read: if signedIn() && resource.data.email == request.auth.token.email;
    }

    match /salesContacts/{contactId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() || canCreateLegacyUser(uid) || canLinkClaimedUser(uid) || canJoinInvitedUser(uid) || canJoinByToken(uid);
      allow update: if isAdmin() || canUpdateUserProfile(uid) || canLinkClaimedUser(uid);
      allow delete: if isAdmin();
    }

    match /publicLeads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['businessId','templateId','status','name','phone','email','budget','requirement','city','area','message','createdAt'])
        && request.resource.data.businessId is string
        && request.resource.data.templateId is string
        && request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.requirement is string
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));
      allow read, update, delete: if signedIn() && ownsBusiness(resource.data.businessId);
    }

    // ---- Public agent page (Sell & Earn link + public listings) ----
    // publicSlugs/{slug}: slug -> business mapping. Anyone can GET one slug (needed by sell.html / listing.html);
    // nobody can LIST them. Only the business owner can create/update/delete. Doc id = slug, so create fails if the slug is taken.
    function validSlug(s) { return s is string && s.matches('^[a-z0-9][a-z0-9-]{2,29}$'); }
    match /publicSlugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if validSlug(slug)
        && request.resource.data.keys().hasOnly(['businessId','businessName','phone','createdAt','updatedAt'])
        && request.resource.data.businessId is string
        && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && isOwnerOfBusiness(request.resource.data.businessId);
      allow update: if isOwnerOfBusiness(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.keys().hasOnly(['businessId','businessName','phone','createdAt','updatedAt']);
      allow delete: if isOwnerOfBusiness(resource.data.businessId);
    }

    // publicListings/{propertyId}: sanitized copy of a property the agent chose to publish.
    // The key whitelist is what keeps owner name/phone and private notes out of public reach.
    match /publicListings/{listingId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['businessId','slug','code','title','type','locality','city','price','size','areaGaj','bedrooms','facing','roadWidth','corner','patta','registry','loan','landmark','mapUrl','note','photos','status','createdAt','updatedAt'])
        && request.resource.data.businessId is string
        && request.resource.data.slug is string
        && request.resource.data.photos is list && request.resource.data.photos.size() <= 6
        && isOwnerOfBusiness(request.resource.data.businessId)
        && exists(/databases/$(database)/documents/publicSlugs/$(request.resource.data.slug))
        && get(/databases/$(database)/documents/publicSlugs/$(request.resource.data.slug)).data.businessId == request.resource.data.businessId
        && (request.method == 'create' || resource.data.businessId == request.resource.data.businessId);
      allow delete: if signedIn() && ownsBusiness(resource.data.businessId);
    }

    match /businesses/{businessId} {
      allow create: if isAdmin() || (signedIn() && request.auth.uid == businessId && request.resource.data.plan in ['trial','free']);
      allow read: if ownsBusiness(businessId) || isAdmin()
        || (signedIn() && resource.data.ownerUid == '' && resource.data.ownerEmail == request.auth.token.email);
      allow update: if isAdmin() || (isBusinessManager(businessId) && request.resource.data.plan == resource.data.plan) || (signedIn() && request.auth.uid == businessId && !('name' in resource.data) && request.resource.data.plan in ['trial','free']) || canClaimBusiness(businessId);
      allow delete: if isAdmin() || (ownsBusiness(businessId) && request.auth.uid == businessId);

      // Permission requests: active team members can submit and read only their own requests.
      // Only the workspace owner can review them. A requester can consume an approved request once.
      match /permissionRequests/{requestId} {
        allow read: if isOwnerOfBusiness(businessId) ||
          (isActiveTeamMember(businessId) && resource.data.requesterUid == request.auth.uid);
        allow create: if isActiveTeamMember(businessId)
          && request.resource.data.keys().hasOnly(['businessId','permission','label','reason','requesterUid','requesterEmail','requesterName','status','createdAt'])
          && request.resource.data.businessId == businessId
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.requesterEmail == request.auth.token.email
          && request.resource.data.permission in ['import_customers','export_customers','export_prospects','export_deals','export_followups','bulk_whatsapp','delete_customers','sensitive_reports']
          && request.resource.data.reason is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if (isOwnerOfBusiness(businessId)
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
          && ((resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'])
            || (resource.data.status == 'approved' && request.resource.data.status == 'revoked')))
          || (isActiveTeamMember(businessId)
            && resource.data.requesterUid == request.auth.uid
            && resource.data.status == 'approved'
            && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedAt']));
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // Lightweight app activity feed. It is useful for workflow visibility, not a tamper-proof audit log.
      match /teamActivity/{activityId} {
        allow read: if isOwnerOfBusiness(businessId);
        allow create: if (isActiveTeamMember(businessId) || isOwnerOfBusiness(businessId))
          && request.resource.data.keys().hasOnly(['businessId','actorUid','actorEmail','actorName','targetEmail','eventType','message','permission','createdAt'])
          && request.resource.data.businessId == businessId
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.eventType in ['permission_requested','permission_approved','permission_rejected','permission_used','permission_revoked','member_disabled','member_activated','member_removed','member_invited','data_imported','data_exported','customer_created','customer_updated','customer_status_changed','customer_interaction','customer_note_saved','followup_scheduled','followup_completed','deal_saved']
          && request.resource.data.message is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /contacts/{contactId} {
        allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
        match /followups/{followupId} {
          allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
        }
      }
      match /deals/{dealId} {
        allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
      }
      match /properties/{propertyId} {
        allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
      }
      // Client submissions from the public sell.html form. Anyone may CREATE a pending submission
      // (strict shape + size limits); only the business team can read/approve/reject/delete.
      match /submissions/{submissionId} {
        allow create: if exists(/databases/$(database)/documents/businesses/$(businessId))
          && request.resource.data.keys().hasOnly(['name','mobile','type','locality','city','price','size','note','photos','status','createdAt'])
          && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 3))
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.mobile is string && request.resource.data.mobile.size() >= 8 && request.resource.data.mobile.size() <= 20
          && request.resource.data.type is string && request.resource.data.type.size() <= 30
          && request.resource.data.locality is string && request.resource.data.locality.size() > 0 && request.resource.data.locality.size() <= 80
          && request.resource.data.city is string && request.resource.data.city.size() <= 60
          && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price < 100000000000
          && request.resource.data.size is string && request.resource.data.size.size() <= 60
          && request.resource.data.note is string && request.resource.data.note.size() <= 1000;
        allow read, update, delete: if ownsBusiness(businessId) || isAdmin();
      }
      match /prospects/{prospectId} {
        allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
      }
      match /settings/{settingId} {
        allow read, create, update, delete: if ownsBusiness(businessId) || isAdmin();
      }
      match /campaigns/{campaignId} {
        allow read: if ownsBusiness(businessId) || isAdmin();
        allow write: if false; // Firebase Admin SDK Cloud Functions write campaign state.
        match /recipients/{contactId} {
          allow read: if ownsBusiness(businessId) || isAdmin();
          allow write: if false;
        }
      }
      match /placeShortlists/{shortlistId} {
        allow read, create, delete: if ownsBusiness(businessId) || isAdmin();
        allow update: if false;
      }
      match /teamInvites/{email} {
        allow read: if isAdmin() || isBusinessManager(businessId) || (signedIn() && resource.data.email == request.auth.token.email);
        // Doc id must equal the invited (lower-case) email, and only the two supported roles can be granted.
        allow create: if (isAdmin() || isBusinessManager(businessId) || (signedIn()
          && email == request.auth.token.email.lower()
          && request.resource.data.email == email
          && request.resource.data.businessId == businessId
          && request.resource.data.role == 'sales'
          && request.resource.data.status == 'active'
          && request.resource.data.joinedVia == 'join-link'
          && request.resource.data.joinToken is string
          && exists(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken))
          && get(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken)).data.status == 'active'
          && get(/databases/$(database)/documents/teamJoinLinks/$(request.resource.data.joinToken)).data.businessId == businessId))
          && request.resource.data.email == email
          && request.resource.data.role in ['sales','admin'];
        allow update: if (isAdmin() || isBusinessManager(businessId))
          && request.resource.data.email == email
          && request.resource.data.role in ['sales','admin'];
        allow delete: if isAdmin() || isBusinessManager(businessId);
      }
    }

    // ---- Manual payments (REVIEW BEFORE DEPLOYING). Approval/rejection happens only in the reviewPayment Cloud Function (Admin SDK). ----
    match /paymentRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerUid','customerName','businessId','planId','amount','currency','durationDays','paymentMethod','paymentStatus','subscriptionStatus','createdAt'])
        && request.resource.data.customerUid == request.auth.uid
        && isOwnerOfBusiness(request.resource.data.businessId)
        && request.resource.data.planId in ['starter','growth']
        && request.resource.data.amount == (request.resource.data.planId == 'starter' ? 499 : 999)
        && request.resource.data.currency == 'INR'
        && request.resource.data.paymentMethod in ['upi','bank']
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.subscriptionStatus == 'inactive'
        && request.resource.data.createdAt == request.time;
      // Customer may only add payment details to their OWN open (pending/rejected) request; never change status to verified.
      allow update: if signedIn() && resource.data.customerUid == request.auth.uid
        && resource.data.paymentStatus in ['pending','rejected']
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentMethod','utr','paymentDate','remarks','customerPhone','whatsappConsent','submittedAt','paymentStatus'])
        && request.resource.data.paymentMethod in ['upi','bank']
        && request.resource.data.utr is string && request.resource.data.utr.size() >= 8 && request.resource.data.utr.size() <= 30
        && request.resource.data.submittedAt == request.time;
      allow delete: if false;
    }
    match /subscriptions/{businessId} {
      allow read: if isAdmin() || isOwnerOfBusiness(businessId);
      allow write: if false;
    }
    match /paymentAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
