rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsBusiness(businessId) { return signedIn() && request.auth.uid == businessId; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /businesses/{businessId} {
      allow read, write: if ownsBusiness(businessId);

      match /contacts/{contactId} {
        allow read, create, update, delete: if ownsBusiness(businessId);
        match /followups/{followupId} {
          allow read, create, update, delete: if ownsBusiness(businessId);
        }
      }

      match /deals/{dealId} {
        allow read, create, update, delete: if ownsBusiness(businessId);
      }
      match /prospects/{prospectId} {
        allow read, create, update, delete: if ownsBusiness(businessId);
      }
      match /settings/{settingId} {
        allow read, create, update, delete: if ownsBusiness(businessId);
      }
    }
  }
}
